{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "majoor.omnicam.track.v1",
  "type": "object",
  "required": ["schema_version", "fps", "duration_frames", "width", "height", "render_mode", "keyframes", "objects", "metadata"],
  "properties": {
    "schema_version": {"const": 1},
    "fps": {"type": "integer", "minimum": 1, "maximum": 120},
    "duration_frames": {"type": "integer", "minimum": 1},
    "width": {"type": "integer", "minimum": 64, "maximum": 4096},
    "height": {"type": "integer", "minimum": 64, "maximum": 4096},
    "render_mode": {"type": "string"},
    "keyframes": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["frame", "camera", "interpolation"]}},
    "objects": {"type": "array"},
    "metadata": {"type": "object"}
  }
}
