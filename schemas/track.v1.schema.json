{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "majoor.omnicam.track.v1",
  "title": "MAJOOR_OMNICAM_TRACK",
  "description": "The canonical camera track. Bounds here mirror omnicam/core/validation.py; tests/test_schemas.py fails if the two drift.",
  "type": "object",
  "required": ["schema_version", "fps", "duration_frames", "width", "height", "render_mode", "keyframes", "objects", "metadata"],
  "properties": {
    "schema_version": {"const": 1},
    "fps": {"type": "integer", "minimum": 1, "maximum": 120},
    "duration_frames": {"type": "integer", "minimum": 1, "maximum": 14400},
    "width": {"type": "integer", "minimum": 64, "maximum": 4096},
    "height": {"type": "integer", "minimum": 64, "maximum": 4096},
    "render_mode": {"enum": ["beauty", "card_grid", "graybox", "grid", "omni_ref", "point_field", "wireframe"]},
    "keyframes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {"$ref": "#/$defs/keyframe"}
    },
    "objects": {"type": "array", "maxItems": 256},
    "camera": {"$ref": "#/$defs/camera"},
    "constraints": {
      "type": "object",
      "properties": {
        "look_at": {
          "type": "object",
          "required": ["object_id", "offset", "space", "status"],
          "properties": {
            "object_id": {"type": "string", "minLength": 1, "maxLength": 80},
            "offset": {"$ref": "#/$defs/vec3"},
            "space": {"const": "world"},
            "status": {"enum": ["active", "disabled_target", "missing_target"]}
          }
        }
      }
    },
    "metadata": {"$ref": "#/$defs/metadata"}
  },
  "$defs": {
    "vec3": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
    "camera": {
      "type": "object",
      "required": ["position", "target", "fov", "roll", "camera_type", "zoom", "near", "far"],
      "properties": {
        "position": {"$ref": "#/$defs/vec3"},
        "target": {"$ref": "#/$defs/vec3"},
        "fov": {"type": "number", "minimum": 5, "maximum": 150},
        "roll": {"type": "number", "minimum": -180, "maximum": 180},
        "camera_type": {"enum": ["orthographic", "perspective"]},
        "zoom": {"type": "number", "exclusiveMinimum": 0},
        "near": {"type": "number", "exclusiveMinimum": 0},
        "far": {"type": "number", "exclusiveMinimum": 0},
        "up": {"$ref": "#/$defs/vec3"}
      },
      "additionalProperties": true
    },
    "keyframe": {
      "type": "object",
      "required": ["frame", "camera", "interpolation"],
      "properties": {
        "frame": {"type": "integer", "minimum": 0, "maximum": 14399},
        "camera": {"$ref": "#/$defs/camera"},
        "interpolation": {"enum": ["bezier", "ease", "ease_in", "ease_out", "hold", "linear", "smooth"]}
      },
      "additionalProperties": true
    },
    "metadata": {
      "type": "object",
      "maxProperties": 64,
      "additionalProperties": {
        "anyOf": [
          {"type": "string", "maxLength": 4096},
          {"type": ["number", "boolean", "null"]},
          {"type": "array", "maxItems": 64},
          {"type": "object", "maxProperties": 64}
        ]
      }
    }
  }
}
