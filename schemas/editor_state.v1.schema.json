{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "majoor.omnicam.editor-state.v1",
  "title": "OMNICAM_EDITOR_STATE",
  "description": "The multi-camera editor document. Bounds mirror omnicam/core/validation.py TrackLimits.",
  "type": "object",
  "required": ["schema_version", "cameras", "objects"],
  "properties": {
    "schema_version": {"const": 1},
    "cameras": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": ["id", "name", "camera", "keyframes"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "name": {"type": "string"},
          "color": {"type": ["string", "null"]},
          "camera": {"type": "object"},
          "keyframes": {"type": "array", "minItems": 1, "maxItems": 10000}
        },
        "additionalProperties": true
      }
    },
    "objects": {"type": "array", "maxItems": 256},
    "active_camera_id": {"type": "string"},
    "playblast_camera_id": {"type": "string"}
  },
  "additionalProperties": true
}
