{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "majoor.omnicam.shot_collection.v1",
  "title": "Director shot collection",
  "description": "Every authored camera as a runtime shot packet. MAX_COLLECTION_SHOTS lives in omnicam/core/director_shot.py.",
  "type": "object",
  "required": ["schema_version", "kind", "shots", "metadata"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "omnicam_shot_collection"},
    "shots": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "majoor.omnicam.shot.v1"}},
    "metadata": {"type": "object"}
  },
  "additionalProperties": false
}
