{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "majoor.omnicam.shot_collection.v1",
  "type": "object",
  "required": ["schema_version", "kind", "shots"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "omnicam_shot_collection"},
    "shots": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "shot.v1.schema.json"}},
    "metadata": {"type": "object"}
  },
  "additionalProperties": false
}
