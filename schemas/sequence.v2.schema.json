{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "majoor.omnicam.sequence.v2",
  "type": "object",
  "required": ["schema_version", "kind", "fps_num", "fps_den", "duration_frames", "width", "height", "shots"],
  "properties": {
    "schema_version": {"const": 2},
    "kind": {"const": "omnicam_sequence"},
    "fps_num": {"type": "integer", "minimum": 1},
    "fps_den": {"type": "integer", "minimum": 1},
    "duration_frames": {"type": "integer", "minimum": 0},
    "width": {"type": "integer", "minimum": 1},
    "height": {"type": "integer", "minimum": 1},
    "shots": {"type": "array", "maxItems": 32}
  },
  "additionalProperties": true
}
