{
  "name": "comfyui-majoor-omnicam-frontend",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "dev": "vite build --mode development --watch",
    "check": "npm run check:lines && npm run check:encoding && node --check web/omnicam.js",
    "check:lines": "node scripts/check_source_lines.mjs",
    "check:encoding": "node scripts/check_text_encoding.mjs",
    "test:unit": "node --test tests/frontend/director-modules.node.mjs tests/frontend/parity.node.mjs tests/frontend/production-bundle.node.mjs tests/frontend/sequencer.node.mjs",
    "test:browser": "playwright test",
    "test:live": "playwright test --config playwright.live.config.mjs"
  },
  "dependencies": {
    "mediabunny": "1.53.1",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "vite": "7.3.6"
  }
}
