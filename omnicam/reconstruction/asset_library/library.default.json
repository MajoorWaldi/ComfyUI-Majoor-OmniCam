    "table":      {"category": "interior", "glb": "interior/table.glb", "base_size": [1.1, 0.75, 0.7], "source": "Kenney Furniture Kit"},
    "desk":       {"category": "interior", "glb": "interior/desk.glb", "base_size": [1.2, 0.75, 0.6], "source": "Kenney Furniture Kit"},
    "bed":        {"category": "interior", "glb": "interior/bedSingle.glb", "base_size": [1.0, 0.55, 2.0], "source": "Kenney Furniture Kit"},
    "cabinet":    {"category": "interior", "glb": "interior/kitchenCabinet.glb", "base_size": [0.6, 0.9, 0.6], "source": "Kenney Furniture Kit"},
    "shelf":      {"category": "interior", "glb": "interior/bookcaseOpen.glb", "base_size": [0.9, 1.8, 0.3], "source": "Kenney Furniture Kit"},
    "counter":    {"category": "interior", "glb": "interior/kitchenBar.glb", "base_size": [1.0, 0.9, 0.6], "source": "Kenney Furniture Kit"},
    "television": {"category": "interior", "glb": "interior/televisionModern.glb", "fit": "stretch", "base_size": [1.2, 0.75, 0.15], "source": "Kenney Furniture Kit"},
    "monitor":    {"category": "interior", "glb": "interior/computerScreen.glb", "fit": "stretch", "base_size": [0.5, 0.4, 0.15], "source": "Kenney Furniture Kit"},
    "lamp":       {"category": "interior", "glb": "interior/lampSquareFloor.glb", "fit": "upright", "base_size": [0.3, 1.5, 0.3], "source": "Kenney Furniture Kit"},
    "plant":      {"category": "interior", "glb": "interior/pottedPlant.glb", "fit": "upright", "base_size": [0.4, 0.9, 0.4], "source": "Kenney Furniture Kit"},
    "door":       {"category": "interior", "glb": "interior/doorwayOpen.glb", "fit": "stretch", "base_size": [1.0, 2.2, 0.2], "source": "Kenney Furniture Kit"},
    "window":     {"category": "interior", "glb": "interior/wallWindow.glb", "fit": "stretch", "base_size": [1.0, 2.5, 0.1], "source": "Kenney Furniture Kit"},
    "box":        {"category": "interior", "glb": "interior/cardboardBoxClosed.glb", "fit": "stretch", "base_size": [0.5, 0.5, 0.5], "source": "Kenney Furniture Kit"},
    "bench":      {"category": "exterior", "glb": "exterior/bench.glb", "base_size": [1.2, 0.5, 0.45], "source": "Kenney Furniture Kit"},
