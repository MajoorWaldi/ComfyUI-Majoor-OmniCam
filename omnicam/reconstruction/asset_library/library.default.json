{
  "version": 1,
  "name": "OmniCam default blockout library (Kenney, CC0)",
  "license": "CC0-1.0",
  "attribution": "Kenney (kenney.nl) — CC0. Credit appreciated, not required.",
  "note": "GLBs are NOT shipped in the repo. Run scripts/fetch_blockout_library.py --from-dir <kits> to populate <ComfyUI>/input/majoor_omnicam/blockout_library/. base_size is the model's approximate authored bounding box in metres; the resolver divides the fitted box by it.",
  "kits": {
    "Kenney Furniture Kit": "https://kenney.nl/assets/furniture-kit",
    "Kenney Car Kit": "https://kenney.nl/assets/car-kit",
    "Kenney City Kit (Roads)": "https://kenney.nl/assets/city-kit-roads",
    "Kenney Nature Kit": "https://kenney.nl/assets/nature-kit",
    "Kenney Blocky Characters": "https://kenney.nl/assets/blocky-characters"
  },
  "assets": {
    "person":     {"category": "human", "fit": "upright", "base_size": [0.6, 1.75, 0.4],
                   "poses": {"standing": "human/character-a.glb"}, "source": "Kenney Blocky Characters"},
    "chair":      {"category": "interior", "glb": "interior/chair.glb", "base_size": [0.5, 0.9, 0.5], "source": "Kenney Furniture Kit"},
    "armchair":   {"category": "interior", "glb": "interior/loungeChair.glb", "base_size": [0.8, 0.85, 0.85], "source": "Kenney Furniture Kit"},
